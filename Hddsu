FOVCircle.Transparency = 0.7
FOVCircle.Color = Color3.fromRGB(255, 255, 255)

-- Логика Аимбота
local function GetTarget()
    local target = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if getgenv().CounterHubConfig.Aimbot.TeamCheck and p.Team == LocalPlayer.Team then
                continue
            end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = p.Character:FindFirstChild(getgenv().CounterHubConfig.Aimbot.AimPart)
                if part then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < getgenv().CounterHubConfig.Aimbot.FOVRadius and dist < shortestDist then
                            shortestDist = dist
                            target = p
                        end
                    end
                end
            end
        end
    end
    return target
end

-- Основной цикл (RenderStepped)
RunService.RenderStepped:Connect(function()
    -- Обновление FOV круга
    FOVCircle.Visible = getgenv().CounterHubConfig.Aimbot.Enabled and getgenv().CounterHubConfig.Aimbot.ShowFOV
    FOVCircle.Radius = getgenv().CounterHubConfig.Aimbot.FOVRadius
    FOVCircle.Position = UserInputService:GetMouseLocation()

    -- Аимбот
    if getgenv().CounterHubConfig.Aimbot.Enabled and UserInputService:IsMouseButtonPressed(getgenv().CounterHubConfig.Aimbot.Key) then
        local t = GetTarget()
        if t and t.Character and t.Character:FindFirstChild(getgenv().CounterHubConfig.Aimbot.AimPart) then
            local part = t.Character[getgenv().CounterHubConfig.Aimbot.AimPart]
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, part.Position), 1 / getgenv().CounterHubConfig.Aimbot.Smoothness)
        end
    end

    -- Bhop
    if getgenv().CounterHubConfig.Movement.Bhop then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum.FloorMaterial ~= Enum.Material.Air then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
    end

    -- SpeedHack
    if getgenv().CounterHubConfig.Movement.SpeedHack then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid").WalkSpeed = getgenv().CounterHubConfig.Movement.SpeedValue
            end
        end)
    end
end)

-- Infinite Jump обработчик
UserInputService.JumpRequest:Connect(function()
    if getgenv().CounterHubConfig.Movement.InfJump then
        pcall(function()
            LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
end)

